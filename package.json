{
  "name": "-ticket-stampede",
  "version": "1.0.0",
  "description": "Build a highly concurrent ticket-booking system that can safely sell a limited number of tickets to thousands of simultaneous users without overselling or duplicate bookings, and prove its correctness using a load-testing client.",
  "main": "index.js",
  "scripts": {
    "test": "npx tsx src/run-all.ts",
    "start:naive": "npx tsx src/seller/naive.ts",
    "start:atomic": "npx tsx src/seller/atomic.ts",
    "start:waitlist": "npx tsx src/seller/waitlist.ts"
  },
